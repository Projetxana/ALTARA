import React from 'react';
import {
    Calendar,
    Home,
    Users,
    Settings,
    Sparkles,
    BarChart,
    Tag,
    Briefcase,
    DollarSign,
    ClipboardList,
    Moon,
    Sun
} from 'lucide-react';
import { useNavigate, useLocation } from 'react-router-dom';
import { useLanguage } from '../../context/LanguageContext';
import { useTheme } from '../../context/ThemeContext';

const Sidebar = () => {
    const navigate = useNavigate();
    const location = useLocation();
    const { t } = useLanguage();
    const { theme, toggleTheme } = useTheme();

    const navItems = [
        { icon: <Calendar size={19} />, label: t('nav_planning'), path: '/planning' },
        { icon: <Home size={19} />, label: t('nav_properties'), path: '/properties' },
        { icon: <ClipboardList size={19} />, label: t('nav_housekeeping') || 'Housekeeping', path: '/housekeeping' },
        { icon: <Tag size={19} />, label: t('nav_pricing'), path: '/pricing' },
        { icon: <Sparkles size={19} />, label: t('nav_experiences'), path: '/experiences' },
        { icon: <Briefcase size={19} />, label: t('nav_soul'), path: '/soul' },
        { icon: <BarChart size={19} />, label: t('nav_analytics'), path: '/analytics' },
        { icon: <DollarSign size={19} />, label: 'Finance', path: '/finance' },
        { icon: <Users size={19} />, label: t('nav_guests'), path: '/guests' }
    ];

    const navStyle = (active) => ({
        display: 'flex',
        alignItems: 'center',
        gap: '0.9rem',
        width: '100%',
        padding: '0.78rem 0.9rem',
        borderRadius: '10px',
        background: active
            ? 'rgba(255,255,255,0.10)'
            : 'transparent',
        border: active
            ? '1px solid rgba(255,255,255,0.08)'
            : '1px solid transparent',
        color: active
            ? '#FFFFFF'
            : 'rgba(255,255,255,0.62)',
        cursor: 'pointer',
        transition: 'all 160ms ease',
        textAlign: 'left',
        fontFamily: 'var(--font-sans)',
        fontSize: '0.9rem',
        fontWeight: active ? 600 : 450
    });

    return (
        <aside
            style={{
                background: '#173A35',
                borderRight: '1px solid rgba(255,255,255,0.08)',
                display: 'flex',
                flexDirection: 'column',
                padding: '2rem 1.25rem 1.5rem',
                minHeight: '100vh'
            }}
        >
            <div
                style={{
                    padding: '0 0.75rem',
                    marginBottom: '2.75rem'
                }}
            >
                <div
                    style={{
                        fontFamily: "'Cormorant Garamond', serif",
                        color: '#FFFFFF',
                        fontSize: '1.75rem',
                        lineHeight: 1,
                        fontWeight: 600,
                        letterSpacing: '0.14em'
                    }}
                >
                    ALTARA
                </div>

                <div
                    style={{
                        width: '30px',
                        height: '2px',
                        marginTop: '0.85rem',
                        background: '#C5A66A',
                        borderRadius: '999px'
                    }}
                />
            </div>

            <nav
                style={{
                    display: 'flex',
                    flexDirection: 'column',
                    gap: '0.28rem'
                }}
            >
                {navItems.map((item) => {
                    const isActive =
                        location.pathname.startsWith(item.path);

                    return (
                        <button
                            key={item.path}
                            onClick={() => navigate(item.path)}
                            style={navStyle(isActive)}
                        >
                            <span
                                style={{
                                    display: 'flex',
                                    alignItems: 'center',
                                    color: isActive
                                        ? '#C5A66A'
                                        : 'rgba(255,255,255,0.52)'
                                }}
                            >
                                {item.icon}
                            </span>

                            <span>{item.label}</span>
                        </button>
                    );
                })}
            </nav>

            <div
                style={{
                    marginTop: 'auto',
                    paddingTop: '1.5rem',
                    borderTop: '1px solid rgba(255,255,255,0.08)',
                    display: 'flex',
                    flexDirection: 'column',
                    gap: '0.3rem'
                }}
            >
                <button
                    onClick={toggleTheme}
                    style={navStyle(false)}
                >
                    {theme === 'dark'
                        ? <Sun size={19} />
                        : <Moon size={19} />
                    }

                    <span>
                        {theme === 'dark'
                            ? 'Mode Clair'
                            : 'Mode Sombre'
                        }
                    </span>
                </button>

                <button
                    onClick={() => navigate('/settings')}
                    style={navStyle(
                        location.pathname === '/settings'
                    )}
                >
                    <Settings size={19} />
                    <span>{t('nav_settings')}</span>
                </button>
            </div>
        </aside>
    );
};

export default Sidebar;
