/* =========================================================
   ALTARA DESIGN SYSTEM — V1
   Premium Property Management
   ========================================================= */

@import url('https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600&family=Playfair+Display:wght@400;500;600&display=swap');

:root {
  /* Brand */
  --altara-midnight: #101720;
  --altara-graphite: #1B2530;
  --altara-stone: #9A8B7E;
  --altara-champagne: #C8B7A5;
  --altara-ivory: #F4F1EC;
  --altara-mist: #9CA5AF;

  /* Semantic colors */
  --color-bg-main: #F7F4EE;
  --color-bg-card: #FFFFFF;
  --color-bg-glass: rgba(255, 255, 255, 0.94);

  --color-primary: var(--altara-stone);
  --color-primary-hover: #AD9D90;
  --color-primary-soft: rgba(154, 139, 126, 0.14);

  --color-accent: var(--altara-champagne);

  --color-text-main: #15211F;
  --color-text: #15211F;
  --color-text-muted: #66716D;

  --color-border: #E5DED3;
  --color-border-strong: rgba(200, 183, 165, 0.26);

  /* Status */
  --color-success: #7FA18C;
  --color-warning: #C6A56B;
  --color-danger: #C77C78;

  /* Typography */
  --font-sans: 'Montserrat', system-ui, -apple-system, sans-serif;
  --font-heading: 'Playfair Display', Georgia, serif;

  /* Radius */
  --radius-sm: 8px;
  --radius-md: 12px;
  --radius-lg: 18px;
  --radius-xl: 24px;

  /* Shadows */
  --shadow-sm:
    0 1px 2px rgba(0, 0, 0, 0.18);

  --shadow-md:
    0 8px 24px rgba(0, 0, 0, 0.16);

  --shadow-lg:
    0 18px 50px rgba(0, 0, 0, 0.22);

  --shadow-glow:
    0 8px 28px rgba(154, 139, 126, 0.16);

  /* Motion */
  --transition-fast: 150ms ease;
  --transition-base: 220ms ease;
}


/* =========================================================
   LIGHT MODE
   ========================================================= */

:root[data-theme="light"] {
  --color-bg-main: #F3F0EB;
  --color-bg-card: #FAF8F5;
  --color-bg-glass: rgba(250, 248, 245, 0.96);

  --color-primary: #88796D;
  --color-primary-hover: #74665C;
  --color-primary-soft: rgba(136, 121, 109, 0.11);

  --color-accent: #A99582;

  --color-text-main: #272421;
  --color-text: #272421;
  --color-text-muted: #756F69;

  --color-border: rgba(77, 68, 61, 0.12);
  --color-border-strong: rgba(77, 68, 61, 0.20);

  --shadow-sm:
    0 1px 2px rgba(55, 45, 38, 0.05);

  --shadow-md:
    0 8px 24px rgba(55, 45, 38, 0.07);

  --shadow-lg:
    0 18px 50px rgba(55, 45, 38, 0.09);

  --shadow-glow:
    0 8px 28px rgba(136, 121, 109, 0.12);
}


/* =========================================================
   RESET
   ========================================================= */

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html,
body,
#root {
  min-height: 100%;
}

body {
  font-family: var(--font-sans);
  background: var(--color-bg-main);
  color: var(--color-text-main);
  line-height: 1.6;
  font-weight: 400;

  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}


/* =========================================================
   TYPOGRAPHY
   ========================================================= */

h1,
h2,
h3,
h4,
h5,
h6 {
  font-family: var(--font-heading);
  color: var(--color-text-main);
  font-weight: 500;
  letter-spacing: -0.015em;
  line-height: 1.2;
}

h1 {
  letter-spacing: -0.025em;
}

p {
  color: inherit;
}

button,
input,
select,
textarea {
  font: inherit;
}


/* =========================================================
   PANELS / CARDS
   ========================================================= */

.glass-panel {
  background: var(--color-bg-glass);
  border: 1px solid var(--color-border);
  box-shadow: var(--shadow-sm);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  transition:
    border-color var(--transition-base),
    box-shadow var(--transition-base),
    background var(--transition-base);
}


/* =========================================================
   PRIMARY BUTTON
   ========================================================= */

.btn-primary {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;

  min-height: 44px;

  padding: 0.7rem 1.35rem;

  background: var(--color-primary);
  color: #FFFFFF;

  border: 1px solid transparent;
  border-radius: var(--radius-md);

  font-family: var(--font-sans);
  font-size: 0.875rem;
  font-weight: 500;
  letter-spacing: 0.01em;

  cursor: pointer;

  box-shadow: none;

  transition:
    background var(--transition-fast),
    transform var(--transition-fast),
    box-shadow var(--transition-fast);
}

.btn-primary:hover:not(:disabled) {
  background: var(--color-primary-hover);
  transform: translateY(-1px);
  box-shadow: var(--shadow-glow);
}

.btn-primary:active:not(:disabled) {
  transform: translateY(0);
}

.btn-primary:disabled {
  opacity: 0.45;
  cursor: not-allowed;
}


/* =========================================================
   INPUTS
   ========================================================= */

input,
select,
textarea {
  background: rgba(255, 255, 255, 0.035);
  color: var(--color-text-main);

  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);

  outline: none;

  transition:
    border-color var(--transition-fast),
    background var(--transition-fast),
    box-shadow var(--transition-fast);
}

input:hover,
select:hover,
textarea:hover {
  border-color: var(--color-border-strong);
}

input:focus,
select:focus,
textarea:focus {
  border-color: var(--color-primary);
  box-shadow: 0 0 0 3px var(--color-primary-soft);
}

input::placeholder,
textarea::placeholder {
  color: var(--color-text-muted);
  opacity: 0.72;
}

:root[data-theme="light"] input,
:root[data-theme="light"] select,
:root[data-theme="light"] textarea {
  background: rgba(255, 255, 255, 0.55);
}


/* =========================================================
   ACCESSIBILITY
   ========================================================= */

button:focus-visible,
a:focus-visible,
input:focus-visible,
select:focus-visible,
textarea:focus-visible {
  outline: 2px solid var(--color-accent);
  outline-offset: 3px;
}


/* =========================================================
   LAYOUT
   ========================================================= */

.container {
  max-width: 1440px;
  margin: 0 auto;
  padding: 0 2rem;
}

.layout-grid {
  display: grid;
  grid-template-columns: 260px minmax(0, 1fr);
  height: 100vh;
  overflow: hidden;
}


/* =========================================================
   SCROLLBAR
   ========================================================= */

::-webkit-scrollbar {
  width: 7px;
  height: 7px;
}

::-webkit-scrollbar-track {
  background: transparent;
}

::-webkit-scrollbar-thumb {
  background: rgba(156, 165, 175, 0.28);
  border-radius: 999px;
}

::-webkit-scrollbar-thumb:hover {
  background: rgba(156, 165, 175, 0.48);
}


/* =========================================================
   SELECTION
   ========================================================= */

::selection {
  background: var(--color-primary);
  color: #FFFFFF;
}


/* =========================================================
   RESPONSIVE FOUNDATION
   ========================================================= */

@media (max-width: 1100px) {
  .layout-grid {
    grid-template-columns: 230px minmax(0, 1fr);
  }
}

/* =========================================================
   ALTARA LIGHT ADMIN — FORM CONTRAST FIX
   ========================================================= */

.layout-grid main input,
.layout-grid main select,
.layout-grid main textarea {
  color: #15211F !important;
  -webkit-text-fill-color: #15211F;
  caret-color: #15211F;
  color-scheme: light;
}

.layout-grid main input::placeholder,
.layout-grid main textarea::placeholder {
  color: #7C8782 !important;
  -webkit-text-fill-color: #7C8782;
  opacity: 1;
}

.layout-grid main input:disabled,
.layout-grid main input[readonly],
.layout-grid main textarea:disabled,
.layout-grid main textarea[readonly],
.layout-grid main select:disabled {
  color: #59645F !important;
  -webkit-text-fill-color: #59645F;
  opacity: 1;
}

.layout-grid main select option {
  background: #FFFFFF;
  color: #15211F;
}

/* Safari date / number / search controls */
.layout-grid main input::-webkit-date-and-time-value {
  color: #15211F;
}

.layout-grid main input::-webkit-calendar-picker-indicator {
  opacity: 0.65;
}

/* Autofill */
.layout-grid main input:-webkit-autofill,
.layout-grid main textarea:-webkit-autofill,
.layout-grid main select:-webkit-autofill {
  -webkit-text-fill-color: #15211F !important;
  box-shadow: 0 0 0 1000px #FFFFFF inset;
}
